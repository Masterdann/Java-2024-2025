import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;

class GFG {
  private static void computePrefixFunction(String pattern, int[] pi) {
    int length = 0;
    pi[0] = 0;
    int i = 1;
    int p = pattern.length();
    while (i < p) {
      if (pattern.charAt(i) == pattern.charAt(length)) {
        length++;
        pi[i] = length;
        i++;
      } else {
        if (length != 0) {
          length = pi[length - 1];
        } else {
          pi[i] = length;
          i++;
        }
      }
    }
  }
  private static void searchPattern(String pattern, String text) {
    int p = pattern.length();
    int t = text.length();

    int[] pi = new int[p];
    computePrefixFunction(pattern, pi);

    int j = 0;
    for (int i = 0; i < t; i++) {
      while (j > 0 && text.charAt(i) != pattern.charAt(j)) {
        j = pi[j - 1];
      }
      if (text.charAt(i) == pattern.charAt(j)) {
        j++;
      }
      if (j == p) {
        System.out.print(i - p + 1 + " ");
        j = pi[j - 1];
      }
    }
  }

  public static void main(String[] args) throws IOException {
    BufferedReader reader =
        new BufferedReader(new InputStreamReader(System.in));
    String pattern = reader.readLine();
    String text = reader.readLine();

    searchPattern(pattern, text);
  }
}
